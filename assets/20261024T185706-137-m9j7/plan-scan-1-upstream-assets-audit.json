  "runtime_contracts": {
    "emscripten_module_files": {
      "type": "Object mapping virtual filesystem paths to ArrayBuffer instances",
      "keys": [
        "default.fmf",
        "nzp/progs.pk3",
        "nzp/game.pk3"
      ],
      "mounting_behavior": "When populated with ArrayBuffer instances before ftewebgl.js runs, FTEQW invokes _emscriptenfte_buf_createfromarraybuf(ab) synchronously, zero XHR downloads"
    },
    "canvas_calibration": {
      "element_id": "canvas",
      "style": "border: 0px none; width: 100%; height: 100%; padding: 0; margin: 0; display: block;"
    },
    "post_run_verification": {
      "hook": "Module.postRun",
      "indicator": "Module[\"sched\"] !== undefined"
    },
    "telemetry_contract": {
      "window_global": "window.__NZP_STATUS__",
      "fields": [
        "initialized",
        "engineReady",
        "gamePk3Bytes",
        "progsPk3Bytes",
        "fmfBytes",
        "wasmLoaded",
        "cacheHit",
        "fps",
        "errors"
